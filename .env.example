# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
APP_NAME=DineIQ API
APP_VERSION=0.1.0
APP_ENV=development
API_PREFIX=/api

# --- Auth (JWT) ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Database (SQL Server via pyodbc) ---
DATABASE_URL=mssql+pyodbc://user:password@localhost:1433/dineiq?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# --- Spark / Hadoop (Windows) ---
HADOOP_HOME=C:\hadoop
PYSPARK_PYTHON=C:\Projects\dineiq-backend\.venv\Scripts\python.exe
PYSPARK_DRIVER_PYTHON=C:\Projects\dineiq-backend\.venv\Scripts\python.exe

# --- Spark session used by the API ---
SPARK_APP_NAME=dineiq-api
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=1g
SPARK_SHUFFLE_PARTITIONS=4

# --- Data paths ---
RAW_DATA_DIR=raw_data
PROCESSED_DATA_DIR=processed_data
PARQUET_DATA_DIR=parquet_data
MODELS_DIR=models
