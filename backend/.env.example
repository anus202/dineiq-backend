DB_SERVER=.
DB_NAME=DineIQ
DB_USER=sa
DB_PASSWORD=123
DB_DRIVER=ODBC Driver 17 for SQL Server

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

BUSINESS_UTC_OFFSET_MINUTES=300
RESTAURANT_NAME=DineIQ Restaurant
LOYALTY_POINTS_PER_100=1
LOYALTY_POINT_VALUE_PKR=1
TIER_GOLD_MIN_POINTS=200
TIER_PLATINUM_MIN_POINTS=400
TIER_SILVER_DISCOUNT_PERCENT=0
TIER_GOLD_DISCOUNT_PERCENT=5
TIER_PLATINUM_DISCOUNT_PERCENT=10

# In-app AI assistant (floating chat widget). Set GROQ_API_KEY *or* ANTHROPIC_API_KEY
# (Groq is tried first if both are set). Leave both blank to keep the widget up but
# showing a "not configured" message instead of a real AI reply.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-haiku-4-5-20251001
