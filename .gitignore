.env
__pycache__/
*.pyc
.venv/
venv/
.venv-bigdata/
node_modules/
dist/

# analytics-pipeline outputs — never checked in; regenerated by running the pipeline
analytics-pipeline/raw_data/*
analytics-pipeline/processed_data/*
analytics-pipeline/models/*
analytics-pipeline/reports/*
!analytics-pipeline/raw_data/.gitkeep
!analytics-pipeline/processed_data/.gitkeep
!analytics-pipeline/models/.gitkeep
